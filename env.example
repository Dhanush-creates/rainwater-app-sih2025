# API Keys for Rainwater Harvesting App
# Copy this file to .env and fill in your actual API keys

# WeatherAPI.com (Primary rainfall data source)
# Get your free API key at: https://www.weatherapi.com/
VITE_WEATHER_API_KEY=your_weather_api_key_here

# AccuWeather (Alternative weather source)
# Get your free API key at: https://developer.accuweather.com/
VITE_ACCUWEATHER_API_KEY=your_accuweather_api_key_here

# Google Gemini AI (For recommendations)
# Get your API key at: https://ai.google.dev/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom API URLs (if needed)
# VITE_WEATHER_API_URL=https://api.weatherapi.com/v1
# VITE_WRIS_API_URL=https://indiawris.gov.in/api
